# Service configuration (all values are examples)
CIVICBRIDGE_SERVER_PORT=49660
CIVICBRIDGE_SERVER_READ_TIMEOUT=30s
CIVICBRIDGE_SERVER_WRITE_TIMEOUT=30s
CIVICBRIDGE_SERVER_SHUTDOWN_TIMEOUT=15s
CIVICBRIDGE_STORAGE_DATA_DIR=./data
CIVICBRIDGE_STORAGE_SHARD_MAX_SIZE=1048576
CIVICBRIDGE_STORAGE_SYNC_ON_WRITE=true
CIVICBRIDGE_SCHEDULER_ESCALATION_INTERVAL=30s
CIVICBRIDGE_SCHEDULER_RECONCILIATION_INTERVAL=5m
CIVICBRIDGE_SCHEDULER_REEVAL_INTERVAL=1m
CIVICBRIDGE_SCHEDULER_MAX_RETRIES=3
CIVICBRIDGE_SCHEDULER_BASE_BACKOFF=1s
CIVICBRIDGE_SCHEDULER_TASK_TIMEOUT=10s
CIVICBRIDGE_LOGGING_LEVEL=info
CIVICBRIDGE_LOGGING_FORMAT=json
CIVICBRIDGE_BUSINESS_DEFAULT_DEADLINE=72h
CIVICBRIDGE_BUSINESS_ESCALATION_DEADLINE_EXTENSION=48h
CIVICBRIDGE_BUSINESS_MAX_ESCALATION_LEVEL=3
CIVICBRIDGE_AUTH_STORE_PATH=./data/auth.json
CIVICBRIDGE_AUTH_SESSION_TTL=8h
